{
	"name": "@glyphtex/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"sync:engine": "node ./scripts/sync-engine.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretest": "esbuild src/lib/landing/text-flip.ts src/lib/tex/tar.ts src/lib/tex/mount.ts src/lib/citations.ts src/lib/compile-cache.ts src/lib/storage/projects.ts src/lib/storage/entry.ts src/lib/storage/bridge.ts src/lib/storage/zip.ts src/lib/storage/import.ts src/lib/storage/ignore.ts src/lib/git/diff.ts src/lib/git/status.ts --bundle --format=esm --outdir=test/.build --outbase=src/lib --out-extension:.js=.mjs --log-level=error",
		"test": "node --test test/*.test.mjs"
	},
	"dependencies": {
		"@glyphtex/ui": "workspace:*",
		"@isomorphic-git/lightning-fs": "^4.6.3",
		"@tabler/icons-svelte": "^3.44.0",
		"buffer": "^6.0.3",
		"clsx": "^2.1.1",
		"glyphtex-engine": "workspace:*",
		"gsap": "^3.15.0",
		"isomorphic-git": "^1.38.10",
		"pdfjs-dist": "6.1.200",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/gsap": "^3.0.0",
		"@types/node": "^26",
		"esbuild": "^0.28.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.42.0"
	}
}
