# Node / Docker. Workers reads the same names from wrangler.jsonc vars and secrets.
PUBLIC_URL=http://localhost:8787
APP_URL=http://localhost:5173
WEB_ORIGINS=
BETTER_AUTH_SECRET=
COOKIE_DOMAIN=
# false only for local testing: sign-up works without opening the verification email.
REQUIRE_EMAIL_VERIFICATION=true
# Keys SCIM bearer tokens (32+ characters). Unset derives one from BETTER_AUTH_SECRET; changing it invalidates tokens.
SCIM_CREDENTIAL_SECRET=
# The header your reverse proxy sets with the real client IP (cf-connecting-ip behind Cloudflare).
CLIENT_IP_HEADER=x-forwarded-for

DATABASE_URL=postgres://glyphtex:glyphtex@localhost:5432/glyphtex
REDIS_URL=redis://localhost:6379

# redis | rabbitmq (Node); Workers always uses Cloudflare Queues.
QUEUE_DRIVER=redis
RABBITMQ_URL=

# File storage for images and fonts. Unset or none: off, so text files only and no card or bucket is needed.
# s3 (any S3-compatible: Neon Object Storage, AWS, R2's S3 API, RustFS, MinIO, B2, Tigris); r2 binding on Workers only.
BLOB_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=glyphtex
S3_ACCESS_KEY_ID=glyphtex
S3_SECRET_ACCESS_KEY=glyphtex-secret

# Unset picks resend or smtp when its credentials are set, otherwise mail is off (no magic links,
# resets or invitation emails, and email verification is not required).
# none | cloudflare (Workers send_email binding; arbitrary recipients need the Workers Paid plan) | resend | smtp (Node only)
MAIL_DRIVER=smtp
MAIL_FROM=GlyphTeX <no-reply@localhost>
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=
