{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.svelte-kit",
			"!**/.turbo",
			"!**/.wrangler",
			"!**/build",
			"!**/dist",
			"!**/target",
			"!**/test/.build",
			"!**/static",
			"!**/src-tauri/gen",
			"!packages/tex-engine/wasm",
			// Verbatim ts-rs output; tex-engine.yml diffs it against a fresh
			// `pnpm generate`, so formatting it would fail that gate.
			"!packages/tex-engine/src/generated",
			// Rust, plus the tectonic/emsdk submodules' vendored JS.
			"!crates",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "none",
			"arrowParentheses": "always"
		}
	},
	"html": {
		"formatter": {
			// Biome only formats a .svelte file's <script> block; without this it
			// unindents it out of the surrounding markup.
			"indentScriptAndStyle": true
		}
	},
	"css": {
		"parser": {
			// @theme / @source / @custom-variant (Tailwind v4).
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noForEach": "off",
				"useLiteralKeys": "off",
				"noUselessSwitchCase": "off",
				"noImportantStyles": "off",
				// LaTeX snippets gain backslashes over time; keep String.raw.
				"noUselessStringRaw": "off"
			},
			"correctness": {
				"noUnusedVariables": {
					"level": "warn",
					"options": {
						"ignoreRestSiblings": true
					}
				},
				"noUnusedImports": "warn",
				"noUnusedFunctionParameters": "off",
				"useUniqueElementIds": "off",
				"noInnerDeclarations": "off",
				// Both fire on Tailwind v4 and Svelte-generated CSS.
				"noUnknownPseudoClass": "off",
				"noUnknownTypeSelector": "off"
			},
			"performance": {
				"noDelete": "off"
			},
			"style": {
				"noParameterAssign": "off",
				"noNonNullAssertion": "off",
				"useTemplate": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noAssignInExpressions": "off",
				"noConsole": "off",
				"noControlCharactersInRegex": "off",
				"noConfusingVoidType": "off",
				"noDocumentCookie": "off",
				"noUndeclaredEnvVars": "off",
				// `${...}` is LaTeX math, not an interpolation typo.
				"noTemplateCurlyInString": "off"
			},
			// Svelte templates are invisible to Biome; svelte-check covers a11y.
			"a11y": {
				"preset": "none"
			}
		}
	},
	"overrides": [
		{
			// Biome cannot see a .svelte template, so anything used only there
			// looks unused.
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
