{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".svelte-kit/**", "build/**", "dist/**", ".vercel/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"lint:rust": {
			"cache": false
		},
		"lint:rust:fix": {
			"cache": false
		},
		"format:rust": {
			"cache": false
		}
	}
}
